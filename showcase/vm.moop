// A tiny stack-based virtual machine, written in MOOP.
//
// The bytecode lives in a LinkedList and the operand stack is a Stack, both
// from the MOOP standard library. The VM has four registers (r0 to r3) and
// fourteen instructions:
//
//   0 HALT        5 DIV         10 JZ addr     (pop, jump if zero)
//   1 PUSH n      6 MOD         11 LOAD r      (push register r)
//   2 ADD         7 DUP         12 STORE r     (pop into register r)
//   3 SUB         8 PRINT       13 LT          (push 1 if a < b, else 0)
//   4 MUL         9 JMP addr
//
// Main loads two bytecode programs and runs them. The comments next to each
// emit() show the disassembly. Try changing PUSH 11 or PUSH 60 to make the
// programs go further.

class Program {
    LinkedList code;

    Program Program() {
        this.code = new LinkedList();
    }

    void emit(int word) {
        LinkedList c;
        c = this.code;
        c.insertElem(word);
    }

    LinkedList getCode() {
        return this.code;
    }
}

class VM {
    LinkedList code;
    Stack stack;
    int r0;
    int r1;
    int r2;
    int r3;
    int steps;

    VM VM(LinkedList code) {
        this.code = code;
        this.stack = new Stack();
        this.steps = 0;
    }

    void push(int v) {
        Stack s;
        s = this.stack;
        s.push(v);
    }

    int pop() {
        Stack s;
        int v;
        s = this.stack;
        v = s.top();
        s.pop();
        return v;
    }

    int getReg(int r) {
        if (r == 0) { return this.r0; }
        if (r == 1) { return this.r1; }
        if (r == 2) { return this.r2; }
        return this.r3;
    }

    void setReg(int r, int v) {
        if (r == 0) { this.r0 = v; }
        if (r == 1) { this.r1 = v; }
        if (r == 2) { this.r2 = v; }
        if (r == 3) { this.r3 = v; }
    }

    int getSteps() {
        return this.steps;
    }

    // fetch, decode, execute until HALT
    void run() {
        LinkedList code;
        int pc;
        int op;
        int a;
        int b;
        bool running;

        code = this.code;
        pc = 0;
        running = true;

        while (running) {
            op = code.getElem(pc);
            this.steps = this.steps + 1;

            if (op == 0) {
                running = false;
            } else if (op == 1) {
                this.push(code.getElem(pc + 1));
                pc = pc + 2;
            } else if (op == 9) {
                pc = code.getElem(pc + 1);
            } else if (op == 10) {
                a = this.pop();
                if (a == 0) {
                    pc = code.getElem(pc + 1);
                } else {
                    pc = pc + 2;
                }
            } else if (op == 11) {
                this.push(this.getReg(code.getElem(pc + 1)));
                pc = pc + 2;
            } else if (op == 12) {
                this.setReg(code.getElem(pc + 1), this.pop());
                pc = pc + 2;
            } else if (op == 8) {
                printi(this.pop());
                pc = pc + 1;
            } else if (op == 7) {
                a = this.pop();
                this.push(a);
                this.push(a);
                pc = pc + 1;
            } else {
                // binary operators: pop b, then a, push (a op b)
                b = this.pop();
                a = this.pop();
                if (op == 2) { this.push(a + b); }
                if (op == 3) { this.push(a - b); }
                if (op == 4) { this.push(a * b); }
                if (op == 5) { this.push(a / b); }
                if (op == 6) { this.push(a - (a / b) * b); }
                if (op == 13) {
                    if (a < b) { this.push(1); } else { this.push(0); }
                }
                pc = pc + 1;
            }
        }
    }
}

class Main {
    int main() {
        Program p;
        VM vm;
        int total;

        print("MOOP VM: a stack machine written in MOOP");
        print("");

        // ---- program 1: factorials of 1 to 10 ----
        p = new Program();
        p.emit(1); p.emit(1); //   0: PUSH 1
        p.emit(12); p.emit(0); //   2: STORE 0
        p.emit(1); p.emit(1); //   4: PUSH 1
        p.emit(12); p.emit(1); //   6: STORE 1
        p.emit(11); p.emit(1); //   8: LOAD 1
        p.emit(11); p.emit(0); //  10: LOAD 0
        p.emit(4);            //  12: MUL
        p.emit(12); p.emit(1); //  13: STORE 1
        p.emit(11); p.emit(1); //  15: LOAD 1
        p.emit(8);            //  17: PRINT
        p.emit(11); p.emit(0); //  18: LOAD 0
        p.emit(1); p.emit(1); //  20: PUSH 1
        p.emit(2);            //  22: ADD
        p.emit(12); p.emit(0); //  23: STORE 0
        p.emit(11); p.emit(0); //  25: LOAD 0
        p.emit(1); p.emit(11); //  27: PUSH 11
        p.emit(13);           //  29: LT
        p.emit(10); p.emit(34); //  30: JZ end
        p.emit(9); p.emit(8); //  32: JMP loop
        p.emit(0);            //  34: HALT

        print("Program 1: factorials of 1 to 10");
        vm = new VM(p.getCode());
        vm.run();
        total = vm.getSteps();

        // ---- program 2: primes below 60 ----
        p = new Program();
        p.emit(1); p.emit(2); //   0: PUSH 2
        p.emit(12); p.emit(0); //   2: STORE 0
        p.emit(11); p.emit(0); //   4: LOAD 0
        p.emit(1); p.emit(60); //   6: PUSH 60
        p.emit(13);           //   8: LT
        p.emit(10); p.emit(56); //   9: JZ done
        p.emit(1); p.emit(2); //  11: PUSH 2
        p.emit(12); p.emit(1); //  13: STORE 1
        p.emit(11); p.emit(1); //  15: LOAD 1
        p.emit(11); p.emit(1); //  17: LOAD 1
        p.emit(4);            //  19: MUL
        p.emit(11); p.emit(0); //  20: LOAD 0
        p.emit(1); p.emit(1); //  22: PUSH 1
        p.emit(2);            //  24: ADD
        p.emit(13);           //  25: LT
        p.emit(10); p.emit(44); //  26: JZ prime
        p.emit(11); p.emit(0); //  28: LOAD 0
        p.emit(11); p.emit(1); //  30: LOAD 1
        p.emit(6);            //  32: MOD
        p.emit(10); p.emit(47); //  33: JZ next
        p.emit(11); p.emit(1); //  35: LOAD 1
        p.emit(1); p.emit(1); //  37: PUSH 1
        p.emit(2);            //  39: ADD
        p.emit(12); p.emit(1); //  40: STORE 1
        p.emit(9); p.emit(15); //  42: JMP inner
        p.emit(11); p.emit(0); //  44: LOAD 0
        p.emit(8);            //  46: PRINT
        p.emit(11); p.emit(0); //  47: LOAD 0
        p.emit(1); p.emit(1); //  49: PUSH 1
        p.emit(2);            //  51: ADD
        p.emit(12); p.emit(0); //  52: STORE 0
        p.emit(9); p.emit(4); //  54: JMP outer
        p.emit(0);            //  56: HALT

        print("");
        print("Program 2: primes below 60");
        vm = new VM(p.getCode());
        vm.run();
        total = total + vm.getSteps();

        print("");
        print("VM instructions executed:");
        printi(total);
        return 0;
    }
}
